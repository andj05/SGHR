@model IEnumerable<SGHR.Application.Dtos.Pisos.PisosDto>

@{
    ViewData["Title"] = "Index";
}

<h1>Pisos</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdPiso)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaCreacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ChangeData)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ChangeUser)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.IdPiso)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descripcion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Estado)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaCreacion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ChangeData)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ChangeUser)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.IdPiso }) |
                @Html.ActionLink("Details", "Details", new { id = item.IdPiso }) |
            </td>
        </tr>
}
    </tbody>
</table>
