@model IEnumerable<SGHR.Application.Dtos.Recepcion.RecepcionDto>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Index</title>
</head>
<body>
    <h1>Recepciones</h1>

    <p>
        <a href="/Recepcion/Create">Create New</a>
    </p>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>IdCliente</th>
                <th>IdHabitacion</th>
                <th>IdEstadoReserva</th>
                <th>FechaEntrada</th>
                <th>FechaSalida</th>
                <th>FechaSalidaConfirmacion</th>
                <th>PrecioInicial</th>
                <th>Adelanto</th>
                <th>PrecioRestante</th>
                <th>TotalPagado</th>
                <th>CostoPenalidad</th>
                <th>Observacion</th>
                <th>Estado</th>
                <th>ChangeDate</th>
                <th>ChangeUser</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><span>@item.Id</span></td>
                    <td><span>@item.IdCliente</span></td>
                    <td><span>@item.IdHabitacion</span></td>
                    <td><span>@item.IdEstadoReserva</span></td>
                    <td><span>@item.FechaEntrada</span></td>
                    <td><span>@item.FechaSalida</span></td>
                    <td><span>@item.FechaSalidaConfirmacion</span></td>
                    <td><span>@item.PrecioInicial</span></td>
                    <td><span>@item.Adelanto</span></td>
                    <td><span>@item.PrecioRestante</span></td>
                    <td><span>@item.TotalPagado</span></td>
                    <td><span>@item.CostoPenalidad</span></td>
                    <td><span>@item.Observacion</span></td>
                    <td><span>@item.Estado</span></td>
                    <td><span>@item.ChangeDate</span></td>
                    <td><span>@item.ChangeUser</span></td>
                    <td>
                        <a href="/Recepcion/Edit/@item.Id">Edit</a> |
                        <a href="/Recepcion/Details/@item.Id">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>