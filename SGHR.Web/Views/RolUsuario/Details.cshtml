@model SGHR.Application.Dtos.RolUsuario.RolUsuarioDto

@{
    ViewData["Title"] = "Details";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalles del Rol de Usuario</title>
</head>
<body>
    <h1>Detalles del Rol de Usuario</h1>

    <div>
        <h4>Información del Rol</h4>
        <hr>
        <dl class="row">
            <dt class="col-sm-2">ID Rol</dt>
            <dd class="col-sm-10"><span>@Model.IdRolUsuario</span></dd>

            <dt class="col-sm-2">Descripción</dt>
            <dd class="col-sm-10"><span>@Model.Descripcion</span></dd>

            <dt class="col-sm-2">Estado</dt>
            <dd class="col-sm-10"><span>@Model.Estado</span></dd>

            <dt class="col-sm-2">Fecha de Creación</dt>
            <dd class="col-sm-10"><span>@Model.FechaCreacion</span></dd>

            <dt class="col-sm-2">Última Modificación</dt>
            <dd class="col-sm-10"><span>@Model.ChangeDate</span></dd>

            <dt class="col-sm-2">Modificado por</dt>
            <dd class="col-sm-10"><span>@Model.ChangeUser</span></dd>
        </dl>
    </div>

    <div>
        <a href="/RolUsuario/Edit/@Model.IdRolUsuario">Editar</a> |
        <a href="/RolUsuario/Index">Volver al listado</a>
    </div>
</body>
</html>