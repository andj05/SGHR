@model IEnumerable<SGHR.Application.Dtos.RolUsuario.RolUsuarioDto>

@{
    ViewData["Title"] = "Index";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rol Usuario</title>
    <link rel="stylesheet" href="path/to/your/css/file.css">
</head>
<body>
    <h1>Rol Usuario</h1>

    <p>
        <a href="/RolUsuario/Create">Create New</a>
    </p>
    <table class="table">
        <thead>
            <tr>
                <th>Id Rol Usuario</th>
                <th>Descripción</th>
                <th>Estado</th>
                <th>Fecha Creación</th>
                <th>Change Date</th>
                <th>Change User</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><span>@item.IdRolUsuario</span></td>
                    <td><span>@item.Descripcion</span></td>
                    <td><span>@item.Estado</span></td>
                    <td><span>@item.FechaCreacion</span></td>
                    <td><span>@item.ChangeDate</span></td>
                    <td><span>@item.ChangeUser</span></td>
                    <td>
                        <a href="/RolUsuario/Edit/@item.IdRolUsuario">Edit</a> |
                        <a href="/RolUsuario/Details/@item.IdRolUsuario">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>
