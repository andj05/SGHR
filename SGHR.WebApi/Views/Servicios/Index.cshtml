@model IEnumerable<SGHR.WebApi.Models.Servicios.ServiciosApiModel>

@{
    ViewData["Title"] = "Lista de Servicios";
}

<div class="container py-4">
    <h1 class="text-center mb-4">Lista de Servicios</h1>

    <div class="d-flex justify-content-start mb-3">
        <a asp-action="Create" class="btn btn-primary">Crear Nuevo</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered text-center">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.IdServicio)</th>
                    <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                    <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                    <th>@Html.DisplayNameFor(model => model.Estado)</th>
                    <th>@Html.DisplayNameFor(model => model.ChangeDate)</th>
                    <th>@Html.DisplayNameFor(model => model.ChangeUser)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.IdServicio)</td>
                        <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                        <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                        <td>@Html.DisplayFor(modelItem => item.Estado)</td>
                        <td>@Html.DisplayFor(modelItem => item.ChangeDate)</td>
                        <td>@Html.DisplayFor(modelItem => item.ChangeUser)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.IdServicio" class="btn btn-outline-warning btn-sm">✏️</a>
                            <a asp-action="Details" asp-route-id="@item.IdServicio" class="btn btn-outline-info btn-sm">ℹ️</a>
                            <a asp-action="Delete" asp-route-id="@item.IdServicio" class="btn btn-outline-danger btn-sm">🗑️</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
