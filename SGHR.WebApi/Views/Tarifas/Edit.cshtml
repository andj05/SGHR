@model SGHR.WebApi.Models.Tarifas.TarifasApiModel

@{
    ViewData["Title"] = "Editar Tarifa";
}

<div class="container py-4">
    <h1 class="text-center mb-4">Editar Tarifa</h1>
    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="IdTarifa" class="form-label"></label>
                    <input asp-for="IdTarifa" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="FechaInicio" class="form-label"></label>
                    <input asp-for="FechaInicio" class="form-control" type="date" />
                </div>

                <div class="mb-3">
                    <label asp-for="FechaFin" class="form-label"></label>
                    <input asp-for="FechaFin" class="form-control" type="date" />
                </div>

                <div class="mb-3">
                    <label asp-for="PrecioPorNoche" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="PrecioPorNoche" class="form-control" type="number" step="0.01" value="@Model.PrecioPorNoche.ToString("0.00")" />
                    </div>
                </div>


                <div class="mb-3">
                    <label asp-for="Descuento" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="Descuento" class="form-control" type="number" step="0.01" />
                        <span class="input-group-text">%</span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <input asp-for="Descripcion" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="IdHabitacion" class="form-label"></label>
                    <input asp-for="IdHabitacion" class="form-control" />
                </div>

                <div class="mb-3 form-check">
                    <input class="form-check-input" asp-for="Estado" />
                    <label class="form-check-label" asp-for="Estado"></label>
                </div>

                <div class="mb-3">
                    <label asp-for="ChangeDate" class="form-label"></label>
                    <input asp-for="ChangeDate" class="form-control" type="datetime-local" />
                </div>

                <div class="mb-3">
                    <label asp-for="ChangeUser" class="form-label"></label>
                    <input asp-for="ChangeUser" class="form-control" />
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Volver</a>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
