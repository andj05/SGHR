@model IEnumerable<SGHR.WebApi.Models.Tarifas.TarifasApiModel>

@{
    ViewData["Title"] = "Lista de Tarifas";
}

<div class="container py-4">
    <h1 class="text-center mb-4">Lista de Tarifas</h1>

    <div class="d-flex justify-content-start mb-3">
        <a asp-action="Create" class="btn btn-primary">Crear Nuevo</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered text-center">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.IdTarifa)</th>
                    <th>@Html.DisplayNameFor(model => model.FechaInicio)</th>
                    <th>@Html.DisplayNameFor(model => model.FechaFin)</th>
                    <th>@Html.DisplayNameFor(model => model.PrecioPorNoche) ($)</th>
                    <th>@Html.DisplayNameFor(model => model.Descuento) (%)</th>
                    <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                    <th>@Html.DisplayNameFor(model => model.IdHabitacion)</th>
                    <th>@Html.DisplayNameFor(model => model.Estado)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.IdTarifa)</td>
                        <td>@Html.DisplayFor(modelItem => item.FechaInicio)</td>
                        <td>@Html.DisplayFor(modelItem => item.FechaFin)</td>
                        <td>$@Html.DisplayFor(modelItem => item.PrecioPorNoche)</td>
                        <td>@Html.DisplayFor(modelItem => item.Descuento) %</td>
                        <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                        <td>@Html.DisplayFor(modelItem => item.IdHabitacion)</td>
                        <td>@Html.DisplayFor(modelItem => item.Estado)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.IdTarifa" class="btn btn-outline-warning btn-sm">✏️</a>
                            <a asp-action="Details" asp-route-id="@item.IdTarifa" class="btn btn-outline-info btn-sm">ℹ️</a>
                            <a asp-action="Delete" asp-route-id="@item.IdTarifa" class="btn btn-outline-danger btn-sm">🗑️</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
