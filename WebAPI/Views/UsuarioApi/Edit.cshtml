@model WebAPI.Models.Usuario.UsuarioModel

@{
    ViewData["Title"] = "Edit Usuario";
}

<h1>Edit Usuario</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="IdUsuario" />
            <input type="hidden" asp-for="FechaCreacion" />

            <div class="form-group mb-3">
                <label asp-for="NombreCompleto" class="control-label"></label>
                <input asp-for="NombreCompleto" class="form-control" />
                <span asp-validation-for="NombreCompleto" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Correo" class="control-label"></label>
                <input asp-for="Correo" class="form-control" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Clave" class="control-label">Nueva Contraseña (Opcional)</label>
                <input asp-for="Clave" type="password" class="form-control" value="" placeholder="Dejar en blanco para mantener la actual" />
                <span asp-validation-for="Clave" class="text-danger"></span>
                <small class="text-muted">Dejar en blanco para mantener la contraseña actual</small>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
