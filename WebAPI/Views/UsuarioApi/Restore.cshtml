@model WebAPI.Models.Usuario.UsuarioModel

@{
    ViewData["Title"] = "Restore";
}

<h1>Restore Usuario</h1>

<h3>Are you sure you want to restore this user?</h3>
<div>
    <h4>Usuario: @Model.NombreCompleto</h4>
    <h4>Email: @Model.Correo</h4>
    <hr />

    <form asp-action="RestoreConfirmed" method="post">
        <input type="hidden" name="id" value="@Model.IdUsuario" />
        @Html.AntiForgeryToken()
        <input type="submit" value="Confirm Restore" class="btn btn-success" />
        <a asp-action="Deleted" class="btn btn-secondary">Back to Deleted List</a>
    </form>
</div>